# Copy to .env and fill in. Every setting in app/config.py can be overridden here.

# --- OpenAI -----------------------------------------------------------------
OPENAI_API_KEY=sk-...
OPENAI_CHAT_MODEL=gpt-4o-mini
# Optional: a stronger model for Ragas / judge evaluation
OPENAI_EVAL_MODEL=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# --- PostgreSQL + pgvector ------------------------------------------------------
DATABASE_URL=postgresql://graphrag:graphrag@localhost:5432/graphrag

# --- Neo4j ----------------------------------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_HTTP_URL=http://localhost:7474
NEO4J_USER=neo4j
NEO4J_PASSWORD=graphrag-password
NEO4J_DATABASE=neo4j
# auto = Bolt driver if the `neo4j` package is installed, otherwise HTTP API
NEO4J_TRANSPORT=auto

# --- API ------------------------------------------------------------------------
# If set, clients must send header X-API-Key
API_KEY=
LOG_LEVEL=INFO

# --- Retrieval & evaluation tuning ------------------------------------------------
GRAPH_MAX_HOPS=2
VECTOR_TOP_K=8
EVALUATE_ON_QUERY=true
EVAL_ENGINE=auto
FAITHFULNESS_THRESHOLD=0.75
MAX_CORRECTION_ATTEMPTS=2
