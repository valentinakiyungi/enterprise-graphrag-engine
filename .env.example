# Copy to .env and fill in. Never commit .env.

# --- OpenAI ---
OPENAI_API_KEY=sk-your-key-here
# OPENAI_BASE_URL=https://your-gateway.example.com/v1   # optional: custom LLM gateway
CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
LLM_TIMEOUT=120
# STRUCTURED_OUTPUT_METHOD=function_calling   # optional; see env.free.example
# For a free setup with no OpenAI account, use env.free.example instead of this file.

# --- PostgreSQL (pgvector) ---
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DSN=postgresql://graphrag:change-me-postgres@localhost:5432/graphrag

# --- Neo4j ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-neo4j
NEO4J_DATABASE=neo4j

# --- Retrieval tuning ---
VECTOR_TOP_K=5
GRAPH_MAX_HOPS=2
GRAPH_FACT_LIMIT=40
GRAPH_CHUNK_LIMIT=5
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# --- Evaluation ---
EVALUATE_BY_DEFAULT=false
FAITHFULNESS_THRESHOLD=0.7

# --- API security: if set, every request except /health must send header X-API-Key ---
API_KEY=
