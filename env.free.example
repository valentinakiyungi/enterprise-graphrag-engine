# 100% free local setup: Ollama runs the models on your own computer, Docker runs the databases.
# Copy to .env (cp env.free.example .env), then replace the three change-me values.
# Prerequisite: Ollama installed and running, with the two models pulled:
#   ollama pull qwen2.5:7b
#   ollama pull nomic-embed-text

# --- Models via Ollama's OpenAI-compatible API ---
# The key is ignored by Ollama but must not be empty.
OPENAI_API_KEY=ollama
# From inside Docker, your computer is host.docker.internal.
# If you run the API directly on your computer instead, use http://localhost:11434/v1
OPENAI_BASE_URL=http://host.docker.internal:11434/v1
CHAT_MODEL=qwen2.5:7b
EMBEDDING_MODEL=nomic-embed-text
# nomic-embed-text produces 768-dimensional vectors
EMBEDDING_DIM=768
# Local models are slow; give each request up to 5 minutes
LLM_TIMEOUT=300
# If ingest reports extraction_failures, try function_calling here
STRUCTURED_OUTPUT_METHOD=json_schema

# --- Databases (free, run by docker compose) ---
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DSN=postgresql://graphrag:change-me-postgres@localhost:5432/graphrag
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-neo4j
NEO4J_DATABASE=neo4j

# --- Retrieval tuning ---
VECTOR_TOP_K=5
GRAPH_MAX_HOPS=2
GRAPH_FACT_LIMIT=40
GRAPH_CHUNK_LIMIT=5
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# --- Evaluation (Ragas scoring with a small local model is slow and sometimes fails) ---
EVALUATE_BY_DEFAULT=false
FAITHFULNESS_THRESHOLD=0.7

# --- API security ---
API_KEY=change-me-api-key
